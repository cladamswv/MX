; DIRTLINE MX - Godot 4.x
config_version=5

[application]
config/name="DIRTLINE MX Arcade 3.4.0"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.012, 0.014, 0.018, 1)
boot_splash/image="res://ui/logo_main.png"
config/icon="res://icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="DIRTLINE_MX"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=0
window/handheld/vsync_mode=1

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=25.5

[rendering]
environment/defaults/default_clear_color=Color(0.20, 0.46, 0.72, 1)
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=8
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048

[input]
throttle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
brake={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
lane_far={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319)]}
lane_near={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321)]}
lean_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
lean_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
boost={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
restart={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
